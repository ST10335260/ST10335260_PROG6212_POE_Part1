@{
    var user = Context.Session.GetSessionUser();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <meta name="description" content="RaceDay: discover and enter road running, walking and cycling events across South Africa." />
    <link rel="icon" type="image/svg+xml" href="~/img/logo-mark.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/raceday.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg rd-nav">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="@(user is { IsOrganiser: true } ? "Organiser" : "Home")" asp-action="@(user is { IsOrganiser: true } ? "Dashboard" : "Index")">
                <img src="~/img/logo-mark.svg" alt="" />RACE<span>DAY</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (user is { IsOrganiser: true })
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserEvents")" asp-controller="OrganiserEvents" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserCategories")" asp-controller="OrganiserCategories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserEnrolments")" asp-controller="OrganiserEnrolments" asp-action="Index">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserResults")" asp-controller="OrganiserResults" asp-action="Index">Results</a></li>
                    }
                    else if (user is { IsParticipant: true })
                    {
                        <li class="nav-item"><a class="nav-link @(Active("Home") + Active("Events"))" asp-controller="Home" asp-action="Index">Discover</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Enrolments")" asp-controller="Participant" asp-action="Enrolments">My enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Results")" asp-controller="Participant" asp-action="Results">My results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @(Active("Home") + Active("Events"))" asp-controller="Home" asp-action="Index">Events</a></li>
                    }
                </ul>

                @if (user is null)
                {
                    <div class="d-flex gap-2 pb-2 pb-lg-0">
                        <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Sign up</a>
                    </div>
                }
                else
                {
                    <div class="dropdown">
                        <a class="user-chip" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">
                                <span>@user.Initials</span>
                                @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                {
                                    <img src="@user.ProfilePictureUrl" alt="" onerror="this.remove()" />
                                }
                            </span>
                            <span>@user.FirstName</span>
                            <span class="role-badge @(user.IsParticipant ? "participant" : "")">@user.Role</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="px-3 py-2">
                                <div class="fw-bold">@user.FullName</div>
                                <div class="small text-muted">@user.Email</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>My profile</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </nav>

    <partial name="_Alerts" />

    <main>
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="rd-brand"><img src="~/img/logo-mark.svg" alt="" />RACE<span>DAY</span></span>
                <div class="mt-1">Road running, walking and cycling events across South Africa.</div>
            </div>
            <div class="text-md-end">
                <div>PROG6212 Part 3 &middot; ST10335260</div>
                <div><a asp-controller="Home" asp-action="Index">Browse events</a></div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" data-confirm-title>Are you sure?</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" data-confirm-message></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Go back</button>
                    <button type="button" class="btn btn-primary" data-confirm-ok>Yes, continue</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
