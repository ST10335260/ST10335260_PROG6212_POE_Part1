@{
    ViewData["Title"] = "Service unavailable";
}
<section class="container py-5">
    <div class="rd-card empty-state mx-auto" style="max-width: 640px;">
        <div class="art"><i class="bi bi-cloud-slash"></i></div>
        <h2>We are warming up</h2>
        <p>RaceDay could not reach its data service just now. This usually clears up within a few seconds, so please try again.</p>
        <a class="btn btn-primary" href="javascript:location.reload()">Try again</a>
    </div>
</section>
