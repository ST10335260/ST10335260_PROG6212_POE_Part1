@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var warning = TempData["Warning"] as string;
}
@if (!string.IsNullOrEmpty(success) || !string.IsNullOrEmpty(error) || !string.IsNullOrEmpty(warning))
{
    <div class="alert-zone" role="status" aria-live="polite">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="rd-alert success" data-autodismiss><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
        }
        @if (!string.IsNullOrEmpty(warning))
        {
            <div class="rd-alert warning" data-autodismiss><i class="bi bi-exclamation-triangle-fill"></i><div>@warning</div></div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="rd-alert error"><i class="bi bi-x-octagon-fill"></i><div>@error</div></div>
        }
    </div>
}
