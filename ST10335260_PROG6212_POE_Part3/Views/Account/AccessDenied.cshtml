@{
    ViewData["Title"] = "Access denied";
    var user = Context.Session.GetSessionUser();
}
<section class="container py-5">
    <div class="rd-card empty-state mx-auto" style="max-width: 640px;">
        <div class="art"><i class="bi bi-shield-lock"></i></div>
        <h2>This area is not for your account</h2>
        <p>Your account type does not have access to that page. Head back to the pages made for you.</p>
        @if (user is { IsOrganiser: true })
        {
            <a class="btn btn-primary" asp-controller="Organiser" asp-action="Dashboard">Go to my dashboard</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse events</a>
        }
    </div>
</section>
