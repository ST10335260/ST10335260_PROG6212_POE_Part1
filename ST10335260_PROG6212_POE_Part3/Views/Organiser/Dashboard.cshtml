@model DashboardInfo
@{
    ViewData["Title"] = "Organiser dashboard";
    var user = Context.Session.GetSessionUser();
}
<section class="page-head">
    <div class="container d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1>Hello, @user?.FirstName</h1>
            <p class="sub">Here is how your events are doing.</p>
        </div>
        <a class="btn btn-volt" asp-controller="OrganiserEvents" asp-action="Create"><i class="bi bi-plus-lg"></i> New event</a>
    </div>
</section>
<div class="container page-body">
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl"><div class="rd-card stat-tile"><div class="ico ico-orange"><i class="bi bi-calendar-event-fill"></i></div><div><div class="num">@Model.TotalEvents</div><div class="lbl">Total events</div></div></div></div>
        <div class="col-sm-6 col-xl"><div class="rd-card stat-tile"><div class="ico ico-blue"><i class="bi bi-hourglass-split"></i></div><div><div class="num">@Model.UpcomingEvents</div><div class="lbl">Upcoming</div></div></div></div>
        <div class="col-sm-6 col-xl"><div class="rd-card stat-tile"><div class="ico ico-green"><i class="bi bi-people-fill"></i></div><div><div class="num">@Model.TotalEnrolments</div><div class="lbl">Enrolments</div></div></div></div>
        <div class="col-sm-6 col-xl"><div class="rd-card stat-tile"><div class="ico ico-amber"><i class="bi bi-clock-history"></i></div><div><div class="num">@Model.PendingEnrolments</div><div class="lbl">Awaiting confirmation</div></div></div></div>
        <div class="col-sm-6 col-xl"><div class="rd-card stat-tile"><div class="ico ico-volt"><i class="bi bi-trophy-fill"></i></div><div><div class="num">@Model.ResultsPublished</div><div class="lbl">Results published</div></div></div></div>
    </div>

    @if (Model.PendingEnrolments > 0)
    {
        <div class="rd-alert warning mb-4"><i class="bi bi-exclamation-triangle-fill"></i><div>@Model.PendingEnrolments @(Model.PendingEnrolments == 1 ? "entry is" : "entries are") waiting for you. <a asp-controller="OrganiserEnrolments" asp-action="Index" class="fw-bold">Review enrolments</a></div></div>
    }

    <div class="rd-card">
        <div class="card-title-row"><h3>Your events</h3><a asp-controller="OrganiserEvents" asp-action="Index" class="fw-semibold">Manage all</a></div>
        @if (Model.Events.Count == 0)
        {
            <div class="empty-state">
                <div class="art"><i class="bi bi-calendar-plus"></i></div>
                <h3>Create your first event</h3>
                <p>Set the date, location and distance, then add categories so people can enter.</p>
                <a class="btn btn-primary" asp-controller="OrganiserEvents" asp-action="Create">Create event</a>
            </div>
        }
        else
        {
            <div class="table-responsive"><table class="rd-table">
                <thead><tr><th>Event</th><th>Date</th><th>Entries</th><th>Status</th><th class="text-end">Quick links</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Events.OrderBy(e => e.EventDate))
                {
                    <tr>
                        <td><div class="d-flex align-items-center gap-3"><div class="thumb ph-@Format.TypeClass(e.EventType)">@if (!string.IsNullOrEmpty(e.BannerUrl)) { <img src="@e.BannerUrl" alt="" onerror="this.remove()" /> } else { <i class="bi @Format.TypeIcon(e.EventType)"></i> }</div><div><div class="row-title">@e.EventName</div><div class="row-sub">@e.Location</div></div></div></td>
                        <td>@Format.ShortDate(e.EventDate)</td>
                        <td>@e.EnrolmentCount</td>
                        <td>@if (e.IsPast) { <span class="status-chip status-published">Completed</span> } else if (!e.IsActive) { <span class="status-chip status-hidden">Hidden</span> } else { <span class="status-chip status-confirmed">Live</span> }</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-soft" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@e.EventId">Enrolments</a>
                            <a class="btn btn-sm btn-soft" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@e.EventId">Results</a>
                        </td>
                    </tr>
                }
                </tbody></table></div>
        }
    </div>
</div>
